#!/bin/sh
# Boot the Hammer V AC profile; the generic Vector quad X remains airframe 4090.
param set-default SYS_AUTOSTART 4091
param set-default BAT1_V_DIV 11.0
param set-default BAT1_A_PER_V 15.0
param set-default SER_TEL1_BAUD 115200
param set-default SER_TEL2_BAUD 115200
param set-default SER_TEL3_BAUD 115200
param set-default SER_TEL4_BAUD 115200
# UART8 receives ESC telemetry. The generic profile uses the RC port
# for serial RC input and starts MAVLink on payload UART4 only.
param set-default DSHOT_TEL_CFG 6
param set-default MAV_0_CONFIG 101
param set-default MAV_1_CONFIG 102
param set-default MAV_1_MODE 0
param set-default MAV_2_CONFIG 103
